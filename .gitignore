# Virtual environment
.venv/
.venv-gpu/

# Python cache
__pycache__/
*.py[cod]
*.so

# Packaging
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.cursor/*
!.cursor/rules/

# Upstream clone (separate git repo)
upstream/

# Environment / secrets
.env
.env.*

# Local-only artifacts
unsloth_compiled_cache/
eval_partial.jsonl
outputs/artifacts/logs/gpu_env_report.txt

# Test / lint / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.log
logs/

# Large run artifacts (regenerable; paths documented in research_log)
**/batch_requests.jsonl
**/all_sentences.csv

# Data — ignore all bulk artifacts; track layout docs (.md), .gitkeep, and small manifest JSON
data/**
!data/**/
!data/**/*.md
!data/**/.gitkeep
!data/manifests/
data/manifests/*
!data/manifests/.gitkeep
!data/manifests/**/*.json

# Run outputs (keep structure, ignore contents)
outputs/artifacts/*
!outputs/artifacts/.gitkeep
!outputs/artifacts/figures/.gitkeep
!outputs/artifacts/logs/.gitkeep
!outputs/artifacts/predictions/.gitkeep
outputs/analysis/*
!outputs/analysis/.gitkeep
outputs/runs/*
!outputs/runs/.gitkeep
# Heavy training checkpoints and API caches (paths still documented in research_log)
outputs/runs/ssc/
outputs/runs/llama/
outputs/runs/prompting/
!outputs/runs/dprose_batch/
outputs/runs/dprose_batch/*
!outputs/runs/dprose_batch/2026-06-20-dprose-batch-pilot-2048/
!outputs/runs/dprose_batch/2026-06-20-dprose-batch-pilot-2048/pilot_summary.json
!outputs/runs/dprose_batch/2026-06-20-dprose-batch-pilot-2048/predictions.jsonl
!outputs/runs/dprose_batch/2026-06-20-dprose-batch-pilot-2048/job_meta.json
!outputs/runs/dprose_batch/2026-06-20-dprose-batch-pilot-2048/predictions_readable.csv
!outputs/runs/dprose_batch/dprose-full-corpus/
outputs/runs/dprose_batch/dprose-full-corpus/*
!outputs/runs/dprose_batch/dprose-full-corpus/final_outputs/
outputs/runs/dprose_batch/dprose-full-corpus/final_outputs/*
!outputs/runs/dprose_batch/dprose-full-corpus/final_outputs/final_report.md
# Review outputs: ignore all by default; keep only selected package trackable
outputs/review/**
!outputs/review/markdown/
!outputs/review/markdown/.gitkeep
!outputs/review/packages/
!outputs/review/packages/.gitkeep
!outputs/review/packages/prompting_rawtxt_nonfree_familyB_reasoning-off_2026-05-16/
!outputs/review/packages/prompting_rawtxt_nonfree_familyB_reasoning-off_2026-05-16/**
!outputs/review/excel/
!outputs/review/excel/.gitkeep

# Explicitly keep key planning/manifest files tracked
!docs/planning/PROJECT_PLAN.md
!docs/prompting/PROMPTING_RESULTS_REPORT.md
!docs/reference/2025.naacl-long.500.pdf

